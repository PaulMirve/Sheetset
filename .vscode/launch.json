{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "9002"],
      "cwd": "${workspaceFolder}/backend",
      "env": { "N8N_API_KEY": "REDACTED_LOCAL_CREDENTIAL" },
      "python": "${workspaceFolder}/backend/.venv/bin/python"
    }
  ]
}
