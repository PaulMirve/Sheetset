meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "first_name": "Ada",
    "last_name": "Lovelace"
  }
}

script:post-response {
  if (res.body.token) bru.setEnvVar("token", res.body.token);
}
