meta {
  name: Column delete
  type: http
  seq: 23
}

delete {
  url: {{baseUrl}}/columns/{{columnId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("deletes the column", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Deletes the column **and its tasks**. Deleting the last one leaves the board with no columns; the app shows an empty state for that.

  Responses: `200` the whole board · `401` · `404`.
}
