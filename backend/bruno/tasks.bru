meta {
  name: Tasks
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/boards/{{boardId}}/tasks
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("lists the board's tasks", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}

docs {
  Every task on `{{boardId}}`, ordered by column and then position. Each task includes its `subtasks`.

  `{{boardId}}` and `{{columnId}}` are set by **Board create**.

  Responses: `200 [...]` · `401` · `404` unknown board or not a member.
}
