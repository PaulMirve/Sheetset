meta {
  name: Meetings
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/meetings?board_id={{boardId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("lists meetings with task counts", function() {
    expect(res.getStatus()).to.equal(200);
    const list = res.getBody();
    expect(list).to.be.an("array").that.is.not.empty;
    expect(list[0]).to.include.keys("id", "title", "date", "task_count");
    if (!bru.getEnvVar("meetingId")) bru.setEnvVar("meetingId", list[0].id);
  });
}

docs {
  Meeting picker list for the signed-in user (run **Login** first so `{{token}}` is set). Newest first.

  Each item: `id`, `title`, `date`, `time`, `platform`, `task_count`. For now every signed-in user sees every meeting.

  Responses: `200 [...]` · `401` missing/invalid token.
}
