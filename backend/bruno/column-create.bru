meta {
  name: Column create
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/boards/{{boardId}}/columns
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Review"
  }
}

tests {
  test("adds the column at the end", function() {
    expect(res.getStatus()).to.equal(201);
    const cols = res.getBody().columns;
    expect(cols[cols.length - 1].name).to.equal("Review");
  });
}

docs {
  Adds a column after the last one.

  Responses: `201` the whole board, so the client can replace its copy · `401` · `404` · `422` invalid body.
}
